# Copy to .env at the repo root:  cp .env.example .env
# setup.sh then hard-links this file into every app/package.

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# ---- API server (apps/api) ----
PORT=8000
BASE_URL=http://localhost:8000
NODE_ENV=development
# LOGGER_LEVEL=debug

# ---- Web (apps/web) ----
# Points the web app at the API server's tRPC endpoint.
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# ---- LLM + embeddings ----
# OpenAI only: gpt-5-mini (reasoning/ranking) + text-embedding-3-small (1536 dims).
OPENAI_API_KEY=

# ---- BIS source API (public, no auth) ----
BIS_API_BASE=https://standardsadmin.bis.gov.in

# ---- Auth (optional — Google OAuth; leave blank to disable) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
