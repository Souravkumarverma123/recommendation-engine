# Copy this to .env.production ON THE EC2 BOX (not in git — .gitignore already excludes it).
# docker-compose.prod.yml loads it for both the `api` and `web` containers.
# NODE_ENV is NOT set here — docker-compose.prod.yml sets it per-service directly
# (api needs exactly "prod", web needs "production"; a shared value can't satisfy both).

# ---- Database (required) ----
# Your Neon production connection string (the one already sitting, commented out,
# in your local .env). Never commit the real value anywhere.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require

# ---- API server (apps/api) ----
PORT=8000
# Public base URL Caddy fronts — used to build the OpenAPI docs' baseUrl.
BASE_URL=https://manak.ultrahuman.co.in

# ---- Web (apps/web) ----
# Intentionally left unset: Caddy same-origin-routes /trpc* to the api container,
# and apps/web/trpc/create-client.ts already defaults to the relative path "/trpc"
# when this is absent — exactly what's wanted here.
# NEXT_PUBLIC_API_URL=

# ---- LLM + embeddings ----
OPENAI_API_KEY=

# ---- BIS source API (public, no auth — override only if it moves) ----
# BIS_API_BASE=https://standardsadmin.bis.gov.in

# ---- Auth (optional — Google OAuth; out of scope for MVP per docs/PRD.md, leave blank) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
